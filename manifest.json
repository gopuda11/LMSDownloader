{
  "manifest_version": 3,
  "name": "LMS Video Downloader",
  "version": "1.0.1",
  "author": "gopuda11 (forked from zinirun)",
  "description": "단국대 및 주요 대학 이러닝(LearningX / Canvas / Uniplayer) 강의 영상을 손쉽게 감지하고 다운로드합니다.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lms-downloader@gopuda11.github.io",
      "strict_min_version": "113.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  },
  "action": {
    "default_icon": "icon-128.png",
    "default_popup": "popup.html",
    "default_title": "LMS Video Downloader"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "default_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "declarativeNetRequest",
    "webRequest"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
