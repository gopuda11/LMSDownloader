{
  "manifest_version": 3,
  "name": "러닝엑스/LMS 다운로더",
  "version": "1.4.0",
  "author": "gopuda11 (forked from zinirun)",
  "description": "단국대 이러닝(LearningX) · 한경대 ILOS 강의 영상 다운로드. PPT/PPTX의 브라우저 내 PDF 변환 기능 포함 (실제 강의자료 미확인).",
  "action": {
    "default_icon": "icon-128.png",
    "default_popup": "popup.html",
    "default_title": "러닝엑스/LMS 다운로더"
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "default_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "declarativeNetRequest",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "*://*.dankook.ac.kr/*",
    "*://dankook-storage.commonscdn.com/*",
    "*://cyber.hknu.ac.kr/*",
    "*://stream.hknu.ac.kr/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://canvas.dankook.ac.kr/learningx/*"
      ],
      "js": [
        "recovery.js",
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://canvas.dankook.ac.kr/learningx/*"
      ],
      "js": [
        "page-capture.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "116",
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src data: blob:; font-src data: blob:; connect-src data: blob:; object-src 'none'; base-uri 'none';"
  }
}
